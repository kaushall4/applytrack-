# ─────────────────────────────────────────────────────────────────────────────
# ApplyTrack configuration — copy to `.env` and fill in.
# `.env` is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# --- Anthropic (optional) ---------------------------------------------------
# If unset, ApplyTrack falls back to the bilingual keyword/heuristic classifier
# and runs fully offline. Set this to enable the LLM classifier.
ANTHROPIC_API_KEY=

# Model used for classification. Default is the cheap Haiku model; set to a
# Sonnet model id for higher accuracy at higher cost.
APPLYTRACK_MODEL=claude-haiku-4-5

# --- Database ---------------------------------------------------------------
# SQLite by default. Swap in a Postgres URL to migrate without code changes,
# e.g. postgresql+psycopg://user:pass@localhost:5432/applytrack
DATABASE_URL=sqlite:///./applytrack.db

# --- Gmail OAuth ------------------------------------------------------------
# Path to the OAuth client file downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Where the cached OAuth token is stored locally (gitignored).
GOOGLE_TOKEN_FILE=token.json

# --- Behaviour --------------------------------------------------------------
# Days without a reply after which an application is flagged "ghosted".
GHOST_THRESHOLD_DAYS=21

# Confidence below which a classification surfaces in the "Needs review" view.
REVIEW_CONFIDENCE_THRESHOLD=0.6

# Senders/recipients to treat as not-application-related (e.g. recruiting
# agencies). Comma-separated domain or address substrings, case-insensitive.
# Example: IGNORED_SENDERS=recruiting-agency.example,acme-recruiting.example
IGNORED_SENDERS=

# CORS origin for the frontend dev server.
FRONTEND_ORIGIN=http://localhost:5173
